# Server-side external provider credentials.
# Never commit real credential values. Configure these in the hosting platform's
# encrypted environment/secrets settings for production.

NITRO_NEWSDATA_API_KEY=
NITRO_WEBZ_API_KEY=
NITRO_TMDB_API_KEY=
NITRO_LASTFM_API_KEY=
NITRO_SPORTSDB_API_KEY=

# Preferred search-momentum source. These are DataForSEO API credentials,
# not a website account password.
NITRO_DATAFORSEO_LOGIN=
NITRO_DATAFORSEO_PASSWORD=
# Maximum number of rotating celebrity trend series refreshed per UTC day.
# 300 covers the current market; lower this if you want to reduce paid requests.
NITRO_DATAFORSEO_DAILY_MARKET_LIMIT=300

# Existing system-level integrations.
NITRO_YOUTUBE_API_KEY=
NITRO_YOUTUBE_CHANNELS={}

# Stripe web store. Keep both values server-side only.
# STRIPE_SECRET_KEY is the restricted/live secret used to create Checkout Sessions.
# STRIPE_WEBHOOK_SECRET is generated when the production /api/stripe/webhook
# endpoint is registered in Stripe Workbench / Webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Market scheduler security. Set CRON_SECRET in Vercel so native Vercel Cron
# sends Authorization: Bearer <CRON_SECRET>. NITRO_MARKET_REFRESH_SECRET can be
# the same long random value and is accepted by external schedulers/admin tools.
CRON_SECRET=
NITRO_MARKET_REFRESH_SECRET=
# A `cycle` request can arrive every two minutes; expensive observation
# collection is performed only when this many minutes have elapsed.
NITRO_MARKET_COLLECTION_MINUTES=60

# Gameplay volatility. Real-world observations establish the anchor; these
# settings control the short-lived game movement around that anchor.
# Default quiet-market pulse amplitude before per-celebrity volatility/spikes.
NITRO_GAME_VOLATILITY_PERCENT=0.9
# Hard cap for one two-minute live tick.
NITRO_GAME_MAX_TICK_MOVE_PERCENT=3
# Maximum displayed cumulative live movement between source refresh resets.
NITRO_GAME_DAILY_MOVE_CAP_PERCENT=45

# Legacy Google Programmable Search credentials. They are retained only for
# configuration compatibility and no longer drive the preferred search signal.
NITRO_GOOGLE_SEARCH_API_KEY=
NITRO_GOOGLE_SEARCH_ENGINE_ID=
